# Copiar este archivo como ".env" en local (nunca commitear el .env real)
# En Render, estas mismas variables se cargan desde el panel del servicio (Environment).

PORT=3000

# Postgres (Render la genera automáticamente al crear la base; copiar la "Internal Database URL"
# si el backend corre en el mismo Render, o la "External" si corre afuera)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_db

# JWT propio (además/en vez de Firebase Auth)
JWT_SECRET=cambiar-por-un-secreto-largo-y-random

# Firebase (proyecto NUEVO y separado del de Todo Sobre mi Club)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
